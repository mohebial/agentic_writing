#!/usr/bin/env python3
"""
Backward compatibility wrapper for NIH Grant Peer Review System.

This script has been moved to gemini_review/main.py as part of package
restructuring. This file now serves as a thin wrapper for backward compatibility.

Usage:
    python grant_review_gemini.py proposal.pdf
    python -m gemini_review proposal.pdf  (recommended - new approach)

For more information, see README.md or run --help:
    python grant_review_gemini.py --help
"""

if __name__ == "__main__":
    from gemini_review import main
    main.main()
